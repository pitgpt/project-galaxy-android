# Optional Realtime secrets. Keep direct values empty in this template.
# Prefer mounted secret files in production; the backend accepts *_FILE paths
# when the deployment mounts those files read-only inside the container.
OPENAI_API_KEY=
SAFETY_IDENTIFIER_HMAC_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# SAFETY_IDENTIFIER_HMAC_KEY_FILE=/run/secrets/safety_identifier_hmac_key
# Supabase Auth: use the project JWKS endpoint and exact issuer (no trailing slash).
# The backend verifies asymmetric RS256/ES256 signing keys; migrate legacy HS256 projects first.
AUTH_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
GALAXY_ENVIRONMENT=production
REDIS_URL=redis://redis:6379/0
GALAXY_ALLOWED_VOICES=alloy,ash,ballad,coral,echo,sage,shimmer,verse
GALAXY_ALLOWED_CHARACTER_IDS=galaxy.default
REALTIME_MODEL=gpt-realtime
REALTIME_CLIENT_SECRET_TTL_SECONDS=600
REALTIME_REQUESTS_PER_MINUTE=5
REALTIME_SESSIONS_PER_DAY=100
REALTIME_MAX_ACTIVE_SESSIONS=2
REALTIME_SESSION_LEASE_SECONDS=90

# Lila Core text provider. Configure the endpoint and model before production startup.
LILA_PROVIDER_ID=default
LILA_PROVIDER_BASE_URL=
LILA_MODEL_ID=
LILA_PROVIDER_TIMEOUT_SECONDS=30
LILA_DATABASE_PATH=/var/lib/galaxy/lila/lila.sqlite3

# Leave these empty in .env. Docker Compose reads values from the host process
# and mounts them as /run/secrets files; they are not added to the container environment.
LILA_STORAGE_ENCRYPTION_KEY=
LILA_PROVIDER_API_KEY=

# Inject secret values through a host secret manager. Do not place them in this file.
# Generate a fresh 32-byte storage key with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Optional custom persona prompt; omit to use the built-in default.
# LILA_SYSTEM_PROMPT=
