OPENAI_API_KEY=replace-me
AUTH_JWKS_URL=https://YOUR_AUTH_ISSUER/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_AUTH_ISSUER/
AUTH_AUDIENCE=galaxy-android
SAFETY_IDENTIFIER_HMAC_KEY=generate-a-long-random-secret
GALAXY_ENVIRONMENT=production
REDIS_URL=redis://redis:6379/0
GALAXY_ALLOWED_VOICES=alloy,ash,ballad,coral,echo,sage,shimmer,verse
GALAXY_ALLOWED_CHARACTER_IDS=galaxy.default
REALTIME_MODEL=gpt-realtime
REALTIME_CLIENT_SECRET_TTL_SECONDS=600
REALTIME_REQUESTS_PER_MINUTE=5
REALTIME_SESSIONS_PER_DAY=100
