<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Device-bound credentials, database and media are intentionally device-only. -->
        <exclude domain="sharedpref" path="galaxy_secure_auth.xml" />
        <exclude domain="sharedpref" path="galaxy_provider_vault.xml" />
        <exclude domain="sharedpref" path="galaxy_database_key.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="galaxy_media/" />
    </cloud-backup>
    <device-transfer>
        <!-- Never transfer encrypted data without its non-exportable device key. -->
        <exclude domain="sharedpref" path="galaxy_secure_auth.xml" />
        <exclude domain="sharedpref" path="galaxy_provider_vault.xml" />
        <exclude domain="sharedpref" path="galaxy_database_key.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="galaxy_media/" />
    </device-transfer>
</data-extraction-rules>
